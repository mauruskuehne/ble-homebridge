{
  "pluginAlias": "SchneiderBLELamps",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Schneider BLE Lamps"
      },
      "devices": {
        "title": "BLE Devices",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "type": "string",
              "required": true,
              "description": "Display name for the device in HomeKit"
            },
            "address": {
              "title": "BLE Address",
              "type": "string",
              "required": true,
              "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
              "description": "BLE MAC address of the device (e.g., AA:BB:CC:DD:EE:FF)"
            }
          }
        },
        "description": "List of BLE lamp devices to control"
      },
      "autoReconnect": {
        "title": "Auto Reconnect",
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Automatically reconnect to disconnected devices"
      },
      "maxReconnectionAttempts": {
        "title": "Max Reconnection Attempts",
        "type": "integer",
        "required": false,
        "default": 10,
        "minimum": 1,
        "maximum": 50,
        "description": "Maximum number of reconnection attempts before giving up"
      },
      "connectionMonitorInterval": {
        "title": "Connection Monitor Interval",
        "type": "integer",
        "required": false,
        "default": 10,
        "minimum": 5,
        "maximum": 60,
        "description": "Interval in seconds to check connection health"
      },
      "initialReconnectionDelay": {
        "title": "Initial Reconnection Delay",
        "type": "integer",
        "required": false,
        "default": 1000,
        "minimum": 500,
        "maximum": 10000,
        "description": "Initial delay in milliseconds before first reconnection attempt"
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Enable debug logging for troubleshooting"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "General Settings",
      "items": [
        "name",
        "debug"
      ]
    },
    {
      "type": "fieldset",
      "title": "BLE Devices",
      "items": [
        {
          "key": "devices",
          "type": "array",
          "orderable": false,
          "buttonText": "Add Device",
          "items": [
            "devices[].name",
            "devices[].address"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Connection Management",
      "items": [
        "autoReconnect",
        "maxReconnectionAttempts",
        "connectionMonitorInterval",
        "initialReconnectionDelay"
      ]
    }
  ]
}
